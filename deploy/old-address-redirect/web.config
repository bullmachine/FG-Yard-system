<?xml version="1.0" encoding="UTF-8"?>
<!--
  Old address redirect. Place this file as the only file in the IIS folder
  htdocsg-yard-system after the app folder is renamed to htdocsg-yard.
  Every request to /fg-yard-system/... is sent permanently to /fg-yard/...,
  so old bookmarks, tablet shortcuts and e-mail links keep working.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Old address to fg-yard" stopProcessing="true">
          <match url="^(.*)$" />
          <action type="Redirect" url="/fg-yard/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
