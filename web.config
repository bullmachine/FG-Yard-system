<?xml version="1.0" encoding="UTF-8"?>
<!--
  fg-yard-system - IIS reverse proxy to the Next.js app running under PM2
  on port 3000.

  Served by IIS at https://projects.bullmachine.in/fg-yard-system/
  The site root is E:\xampp\htdocs, so this folder is a plain subdirectory.
  IIS URL Rewrite match patterns here are relative to this folder.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Deny dotfiles" stopProcessing="true">
          <match url="(^|/)\." />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- Root: proxy to /fg-yard-system WITHOUT a trailing slash, because
             Next.js answers /fg-yard-system/ with a 308 back to /fg-yard-system. -->
        <rule name="Proxy root" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/fg-yard-system" />
        </rule>

        <!-- Everything else, including _next assets and client routes. -->
        <rule name="Proxy app" stopProcessing="true">
          <match url="^(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/fg-yard-system/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
